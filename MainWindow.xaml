<Window x:Class="WinPowerTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="WinPowerTools Suite"
        Height="520" Width="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="#0F1117"
        ResizeMode="NoResize"
        AllowDrop="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38"
                      CornerRadius="12"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="WindowBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="8,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#282D3D"/>
                    <Setter Property="Foreground" Value="#F8FAFC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Display"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="10,8" Margin="0,2">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E2330"/>
                    <Setter Property="Foreground" Value="#F8FAFC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#38BDF8"/>
            <Setter Property="Foreground" Value="#0F1117"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Display"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7DD3FC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseBtnStyle" TargetType="Button" BasedOn="{StaticResource WindowBtnStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EF4444"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="#0F1117" BorderBrush="#282D3D" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/> <!-- Başlık -->
                <RowDefinition Height="*"/>    <!-- İçerik -->
            </Grid.RowDefinitions>

            <!-- 1. BAŞLIK ÇUBUĞU -->
            <Grid Grid.Row="0" Background="#0F1117" Margin="14,0,8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡" Foreground="#A855F7" FontSize="14" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="WinPowerTools Suite" Foreground="#F8FAFC" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="v1.0" Foreground="#64748B" FontSize="10" Margin="6,2,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="—" Style="{StaticResource WindowBtnStyle}" Click="BtnMinimize_Click"/>
                    <Button Content="✕" Style="{StaticResource CloseBtnStyle}" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>

            <!-- 2. ANA İÇERİK (SOL MENÜ + SAĞ PANEL) -->
            <Grid Grid.Row="1" Margin="12,4,12,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/> <!-- Yan Navigasyon Menüsü -->
                    <ColumnDefinition Width="*"/>   <!-- Aktif Sayfa -->
                </Grid.ColumnDefinitions>

                <!-- SOL NAVİGASYON -->
                <Border Grid.Column="0" Background="#141721" BorderBrush="#282D3D" BorderThickness="1" CornerRadius="8" Padding="6">
                    <StackPanel>
                        <TextBlock Text="ARAÇLAR" Foreground="#64748B" FontSize="9" FontWeight="Bold" Margin="6,4,0,6"/>
                        <Button x:Name="NavUnlocker" Content="🔓 Dosya Kilidi Çözücü" Style="{StaticResource NavBtnStyle}" Click="NavUnlocker_Click"/>
                        <Button x:Name="NavCleaner" Content="🧹 Gizli Çöp Temizleyici" Style="{StaticResource NavBtnStyle}" Click="NavCleaner_Click"/>
                        <Button x:Name="NavHog" Content="🌐 Trafik &amp; Disk Bekçisi" Style="{StaticResource NavBtnStyle}" Click="NavHog_Click"/>
                        <Button x:Name="NavSleep" Content="🔋 Pil &amp; Uyku Kontrolü" Style="{StaticResource NavBtnStyle}" Click="NavSleep_Click"/>
                        <Button x:Name="NavPin" Content="📌 Pencere Sabitleyici" Style="{StaticResource NavBtnStyle}" Click="NavPin_Click"/>
                    </StackPanel>
                </Border>

                <!-- SAĞ PANEL KARTLARI -->
                <Border Grid.Column="1" Background="#181B24" BorderBrush="#282D3D" BorderThickness="1" CornerRadius="8" Margin="8,0,0,0" Padding="14">
                    <Grid>
                        <!-- ================= MODÜL 1: DOSYA KİLİDİ ÇÖZÜCÜ ================= -->
                        <Grid x:Name="PanelUnlocker" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="70"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="Dosya Kilidi &amp; Rehin Alan Süreç Bulucu" Foreground="#F8FAFC" FontSize="13" FontWeight="Bold"/>
                                <TextBlock Text="Silinmeyen veya taşınmayan dosyayı rehin tutan Windows süreçlerini tespit edin." Foreground="#94A3B8" FontSize="10"/>
                            </StackPanel>

                            <!-- Sürükle Bırak Alanı -->
                            <Border Grid.Row="1" Background="#0F1117" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="6"
                                    AllowDrop="True" Drop="FileDropArea_Drop" DragOver="FileDropArea_DragOver" Cursor="Hand" MouseDown="FileDropArea_Click">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="📂 Dosyayı buraya sürükleyip bırakın veya tıklayarak seçin" Foreground="#38BDF8" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtSelectedFilePath" Text="(Henüz dosya seçilmedi)" Foreground="#64748B" FontSize="9" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Grid.Row="2" Text="DOSYAYI KİLİTLEYEN SÜREÇLER:" Foreground="#64748B" FontSize="9" FontWeight="Bold" Margin="0,10,0,4"/>

                            <!-- Kilitleyen Süreçler Listesi -->
                            <ListBox x:Name="ListLockingProcs" Grid.Row="3" Background="#0F1117" BorderBrush="#282D3D" BorderThickness="1">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="⚠️" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding AppName}" Foreground="#F8FAFC" FontSize="11" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding FilePath}" Foreground="#64748B" FontSize="8" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding MemoryUsage}" Foreground="#A855F7" FontSize="10" Margin="10,0,10,0" VerticalAlignment="Center"/>
                                            <Button Grid.Column="3" Content="Süreci Sonlandır" Style="{StaticResource ActionBtnStyle}" Background="#EF4444" Foreground="White"
                                                    Click="BtnKillProcess_Click" Tag="{Binding ProcessId}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock x:Name="TxtUnlockStatus" Grid.Row="4" Text="" Foreground="#34D399" FontSize="10" Margin="0,6,0,0"/>
                        </Grid>

                        <!-- ================= MODÜL 2: GİZLİ ÇÖP TEMİZLEYİCİ ================= -->
                        <Grid x:Name="PanelCleaner" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Gizli Sistem &amp; Geliştirici Çöpü Temizleyici" Foreground="#F8FAFC" FontSize="13" FontWeight="Bold"/>
                                    <TextBlock Text="iPhone yedekleri, pip/nuget önbellekleri ve shader kalıntılarını tarayın." Foreground="#94A3B8" FontSize="10"/>
                                </StackPanel>
                                <Button Content="🔍 Çöpleri Tara" Style="{StaticResource ActionBtnStyle}" HorizontalAlignment="Right" Click="BtnScanJunk_Click"/>
                            </Grid>

                            <ListBox x:Name="ListJunkCategories" Grid.Row="1" Background="#0F1117" BorderBrush="#282D3D" BorderThickness="1">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="6,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Foreground="#F8FAFC" FontSize="11" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Description}" Foreground="#64748B" FontSize="9"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding FormattedSize}" Foreground="#34D399" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Grid Grid.Row="2" Margin="0,10,0,0">
                                <TextBlock x:Name="TxtJunkStatus" Text="Taramak için 'Çöpleri Tara' butonuna basın." Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center"/>
                                <Button x:Name="BtnCleanSelected" Content="🧹 Seçilenleri Güvenle Temizle" Style="{StaticResource ActionBtnStyle}" HorizontalAlignment="Right" Click="BtnCleanSelected_Click" Background="#10B981"/>
                            </Grid>
                        </Grid>

                        <!-- ================= MODÜL 3: TRAFİK & DİSK BEKÇİSİ ================= -->
                        <Grid x:Name="PanelHog" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="Canlı Süreç I/O &amp; Kaynak Bekçisi" Foreground="#F8FAFC" FontSize="13" FontWeight="Bold"/>
                                <TextBlock Text="Diski veya ağı en çok kullanan süreçler milisaniyelik Win32 çekirdek sayaçlarıyla listelenir." Foreground="#94A3B8" FontSize="10"/>
                            </StackPanel>

                            <ListBox x:Name="ListHogs" Grid.Row="1" Background="#0F1117" BorderBrush="#282D3D" BorderThickness="1">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="6,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Foreground="#F8FAFC" FontSize="11" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Pid, StringFormat='PID: {0}'}" Foreground="#64748B" FontSize="9"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0">
                                                <TextBlock Text="{Binding FormattedRead, StringFormat='⬇ {0}'}" Foreground="#34D399" FontSize="9"/>
                                                <TextBlock Text="{Binding FormattedWrite, StringFormat='⬆ {0}'}" Foreground="#38BDF8" FontSize="9"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding FormattedTotal}" Foreground="#FBBF24" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <!-- ================= MODÜL 4: PİL & UYKU KONTROLÜ ================= -->
                        <Grid x:Name="PanelSleep" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Pil Durumu &amp; Modern Standby Uyku Yöneticisi" Foreground="#F8FAFC" FontSize="13" FontWeight="Bold"/>
                                <TextBlock Text="Laptop kapağı kapandığında uykuyu engelleyen durumları aşın veya anında uykuya geçin." Foreground="#94A3B8" FontSize="10" Margin="0,0,0,14"/>

                                <Border Background="#0F1117" BorderBrush="#282D3D" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock x:Name="TxtBatteryState" Text="Prizde (Şarj Oluyor)" Foreground="#34D399" FontSize="13" FontWeight="Bold"/>
                                            <TextBlock x:Name="TxtBatteryRemaining" Text="Sürekli Güç Kaynağı" Foreground="#94A3B8" FontSize="10" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtBatteryPercent" Text="%100" Foreground="#38BDF8" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="🌙 Zorla Uykuya Al (Sleep)" Style="{StaticResource ActionBtnStyle}" Click="BtnForceSleep_Click" Margin="0,0,10,0"/>
                                    <Button Content="💤 Hazırda Beklet (Hibernate)" Style="{StaticResource ActionBtnStyle}" Background="#6366F1" Foreground="White" Click="BtnForceHibernate_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- ================= MODÜL 5: PENCERE SABİTLEYİCİ ================= -->
                        <Grid x:Name="PanelPin" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Evrensel Pencere Sabitleyici (Always-on-Top)" Foreground="#F8FAFC" FontSize="13" FontWeight="Bold"/>
                                <TextBlock Text="Herhangi bir Windows uygulamasını klavye kısayolu ile daima en üstte tutun." Foreground="#94A3B8" FontSize="10" Margin="0,0,0,14"/>

                                <Border Background="#0F1117" BorderBrush="#282D3D" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="KÜRESEL KLAVYE KISAYOLU" Foreground="#64748B" FontSize="9" FontWeight="Bold"/>
                                        <Border Background="#1E2330" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" Margin="0,4,0,10">
                                            <TextBlock Text="Ctrl + Space (Boşluk)" Foreground="#FBBF24" FontSize="13" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Text="1. Sabitlemek istediğiniz pencereye (Not Defteri, PDF, Tarayıcı) tıklayın." Foreground="#94A3B8" FontSize="10"/>
                                        <TextBlock Text="2. Ctrl + Space tuşlarına basın. Pencere en üste sabitlenecektir!" Foreground="#94A3B8" FontSize="10"/>
                                    </StackPanel>
                                </Border>

                                <Button Content="📌 O Anki Aktif Pencereyi Sabitle / Çöz" Style="{StaticResource ActionBtnStyle}" Click="BtnPinActiveWindow_Click" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="TxtPinFeedback" Text="" Foreground="#34D399" FontSize="10" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
